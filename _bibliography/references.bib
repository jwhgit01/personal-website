@inproceedings{hopwoodNoiseStateStableReducedOrderToAppear,
  title = {A {{Noise-to-State Stable Reduced-Order Symmetry-Preserving Observer}} for {{Wind Estimation}} in {{Turbulence}}},
  booktitle = {{{AIAA SCITECH}} 2025 {{Forum}}},
  author = {Hopwood, Jeremy W. and Woolsey, Craig A.},
  pages = {\emph{To Appear}},
  publisher = {{American Institute of Aeronautics and Astronautics}},
  address = {Orlando, FL},
  abstract = {Inferring wind velocity from aircraft motion is an enabling technology that can be used for synthetic air data systems, path planning, safety monitoring, numerical weather prediction, and atmospheric science. Model-based wind estimates incorporate an aerodynamic model to improve performance as well as obtain mathematically stronger results built upon fewer assumptions. However, many approaches rely on a small-perturbation assumption, weakening any convergence guarantees. This paper presents a nonlinear extended state observer for aircraft in turbulent wind with stochastic stability guarantees. Using an immersion and invariance approach with a symmetry-preserving formulation, the observer design problem is reduced to a linear one but with no small-perturbation assumption required. Furthermore, extensions to these bodies of theory allowing for stochastic differential equations provide probabilistic convergence guarantees on the state estimates. In the final paper, a flight test demonstration will be included, to demonstrate the powerful guarantees that are obtained for the stochastic nonlinear system.},
  year = {2025}
}

